# PostgreSQL connection string used by @devmentor/db
DATABASE_URL=postgresql://devmentor:devmentor@localhost:5432/devmentor

# Optional connection pool size (defaults: 2 / 10)
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=5000

# pino log level: fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info
