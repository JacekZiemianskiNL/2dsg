{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run dev -w @devmentor/app --",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run migration:up -w @devmentor/db",
    "db:migration:create": "npm run migration:create -w @devmentor/db --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^5.9.3"
  }
}
